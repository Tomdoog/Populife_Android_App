<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/layout_view_titlebar"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">
    <RelativeLayout
        android:id="@+id/rl_gateway_binded_lock_time_read"
        android:padding="@dimen/common_page_left_right_space"
        android:layout_marginLeft="@dimen/common_page_left_right_space"
        android:layout_marginRight="@dimen/common_page_left_right_space"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="40dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/device_card_single_bg">


        <ImageView
            android:src="@drawable/clock_icon"
            android:id="@+id/iv_clock_icon"
            android:layout_alignParentLeft="true"
            android:layout_alignParentTop="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:layout_alignParentTop="true"
            android:layout_toRightOf="@+id/iv_clock_icon"
            android:id="@+id/tv_lock_time_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_time"
            android:textColor="@color/common_text_color"
            android:layout_marginLeft="14dp"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tv_lock_time"
            android:layout_below="@+id/tv_lock_time_label"
            android:layout_toRightOf="@+id/iv_clock_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginLeft="14dp"
            android:textColor="@color/common_text_color"
            android:textSize="20sp"/>

    </RelativeLayout>

    <TextView
        android:id="@+id/tv_lock_time_calibrate"
        style="@style/btn_style_main"
        android:layout_marginLeft="@dimen/common_page_left_right_space"
        android:layout_marginRight="@dimen/common_page_left_right_space"
        android:text="@string/calibrate_time"/>


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/common_page_left_right_space"
            android:layout_marginEnd="@dimen/common_page_left_right_space"
        android:layout_marginTop="12dp"
        android:text="@string/calibrate_time_only_hint"
        android:textColor="@color/common_text_color"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/lock_timezone_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/common_page_left_right_space"
            android:layout_marginEnd="@dimen/common_page_left_right_space"
            android:layout_marginTop="32dp"
            android:padding="@dimen/common_page_left_right_space"
            android:orientation="vertical"
            android:background="@drawable/device_card_single_bg">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/lock_timezone"
                android:textSize="20sp"
                android:textColor="@color/common_text_color" />
            <TextView
                android:id="@+id/tv_lock_timezone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="20sp"
                android:textColor="@color/common_text_color" />
        </LinearLayout>
        <TextView
            android:id="@+id/tv_lock_timezone_calibrate"
            style="@style/btn_style_main"
            android:layout_marginStart="@dimen/common_page_left_right_space"
            android:layout_marginEnd="@dimen/common_page_left_right_space"
            android:layout_marginTop="24dp"
            android:text="@string/calibrate_timezone" />
        <TextView
            android:id="@+id/tv_lock_timezone_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/common_page_left_right_space"
            android:layout_marginEnd="@dimen/common_page_left_right_space"
            android:layout_marginTop="12dp"
            android:text="@string/calibrate_timezone_hint"
            android:textColor="@color/common_text_color"
            android:textSize="13sp" />
    </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>

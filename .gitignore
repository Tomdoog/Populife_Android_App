# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/caches
.diea

# Keystore and local secrets. Historical tracked files require a separate
# credential-rotation/history-cleanup decision; these rules prevent new files.
KeyStore/
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision
.env
.env.*
!.env.example
secrets/
service-account*.json
firebase-adminsdk*.json
google-credentials*.json

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild

# Google Services (e.g. APIs or Firebase)
google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# IDE 本机环境：JDK 版本与插件设置因人而异，入库会强制他人跟随
.idea/compiler.xml
.idea/misc.xml
.idea/appInsightsSettings.xml
.idea/markdown.xml
.idea/material_theme_project_new.xml

# 排障用的 logcat 导出：含 token / 手机号 / userId，且是一次性产物
*.logcat

# 汇报与方案材料：二进制不可 diff，改一版仓库里就永久多存一份
docs/*.pptx
docs/*.pdf

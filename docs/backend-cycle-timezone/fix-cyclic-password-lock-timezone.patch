@@ -0,0 +1,51 @@
+package com.igloo.smarthome.utils;
+
+import java.time.DayOfWeek;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.time.ZoneOffset;
+import java.time.format.DateTimeFormatter;
+import java.time.format.ResolverStyle;
+import java.time.temporal.TemporalAdjusters;
+import java.util.Locale;
+
+/** 循环密码的日期、星期和时间戳始终使用绑定时保存的锁时区。 */
+public final class CyclicPasswordTime {
+    private static final DateTimeFormatter DATE_TIME = DateTimeFormatter
+            .ofPattern("uuuu-MM-dd HH:mm", Locale.ROOT)
+            .withResolverStyle(ResolverStyle.STRICT);
+
+    private CyclicPasswordTime() {}
+
+    public static boolean isCyclic(Integer type) {
+        return type != null && type >= 5 && type <= 14;
+    }
+
+    public static String datePrefix(int type, long nowMillis, Long lockOffsetMillis) {
+        if (!isCyclic(type)) throw new IllegalArgumentException("Not a cyclic passcode type");
+        LocalDate date = Instant.ofEpochMilli(nowMillis).atOffset(offset(lockOffsetMillis)).toLocalDate();
+        int weekday = date.getDayOfWeek().getValue();
+        if (type == 5 && weekday < 6) {
+            date = date.with(TemporalAdjusters.nextOrSame(DayOfWeek.SATURDAY));
+        } else if (type == 7 && weekday > 5) {
+            date = date.with(TemporalAdjusters.nextOrSame(DayOfWeek.MONDAY));
+        } else if (type >= 8) {
+            date = date.with(TemporalAdjusters.nextOrSame(DayOfWeek.of(type - 7)));
+        }
+        return date.toString() + " ";
+    }
+
+    public static long toEpochMillis(String localDateTime, Long lockOffsetMillis) {
+        return LocalDateTime.parse(localDateTime, DATE_TIME)
+                .toInstant(offset(lockOffsetMillis)).toEpochMilli();
+    }
+
+    private static ZoneOffset offset(Long millis) {
+        // 不把缺失时区当 UTC；毫秒偏移不经整小时截断，保留半小时等时区。
+        if (millis == null || millis % 1000 != 0 || millis < -64800000L || millis > 64800000L) {
+            throw new IllegalArgumentException("Lock time zone is missing or invalid");
+        }
+        return ZoneOffset.ofTotalSeconds((int) (millis / 1000));
+    }
+}
